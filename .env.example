# Zerodha Kite credentials (keep secrets blank in this template)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_STATIC_IP=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_MODE=shadow
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_RETRIES=0
OPENAI_REASONING_EFFORT=low

# Live-order safety. Keep disabled unless all live-readiness checks pass.
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=

# Capital and risk
CAPITAL_LIMIT=100000
RISK_PER_TRADE_PCT=0.0020
MAX_POSITION_PCT=0.25
MAX_DAILY_LOSS_PCT=0.008
MAX_TRADES_PER_DAY=5
MAX_OPEN_POSITIONS=2
MAX_CONSECUTIVE_LOSSES=3

# Candidate selection
PRELIMINARY_POOL_SIZE=100
CANDIDATE_POOL_SIZE=35
TECH_MIN_SCORE=74
AI_MIN_CONFIDENCE=80
MIN_PRICE=50
MAX_PRICE=10000
MAX_SPREAD_BPS=18
MIN_ABS_CHANGE_PCT=0.35
MAX_ABS_CHANGE_PCT=10.0
MIN_DAY_RANGE_PCT=0.60
MIN_CIRCUIT_BUFFER_PCT=1.0
MAX_GAP_PCT=8.0

# Setup filters
MIN_RVOL=1.35
MIN_ATR_PCT=0.0025
MAX_ATR_PCT=0.025
MAX_VWAP_DISTANCE_ATR=1.8
MIN_BREAKOUT_DISTANCE_ATR=0.04
MAX_BREAKOUT_DISTANCE_ATR=0.80

# Trade construction and signal freshness
ATR_STOP_MULTIPLIER=1.20
TARGET_R_MULTIPLE=1.80
MAX_SIGNAL_AGE_SECONDS=240
MAX_ENTRY_DRIFT_ATR=0.30

# Execution confirmation
ENTRY_FILL_TIMEOUT_SECONDS=15
STOP_ARM_TIMEOUT_SECONDS=10
EXIT_FILL_TIMEOUT_SECONDS=15
ORDER_POLL_SECONDS=0.50
PAPER_SLIPPAGE_BPS=5

# Scheduling and REST-rate safety
FULL_SCAN_EVERY_SECONDS=180
POSITION_MONITOR_EVERY_SECONDS=5
CANDLE_DELAY_SECONDS=0.36
INDICATOR_LOOKBACK_DAYS=21

# WebSocket
WS_MAX_INSTRUMENTS_PER_CONNECTION=2800
WS_ACTIVE_TICK_MAX_AGE_SECONDS=180
WS_WARMUP_SECONDS=15
